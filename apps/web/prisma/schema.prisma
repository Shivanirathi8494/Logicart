generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LogicartsSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Airline {
  id             String   @id @default(cuid())
  name           String   @unique
  iataDesignator String   @unique
  icaoCode       String   @unique
  iataPrefix     String?  @unique
  country        String   @default("India")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shipments    Shipment[]
  awbSequence  AwbSequence?
  cargoTariffs AirCargoTariff[]
}

model AirCargoTariff {
  id            String   @id @default(cuid())
  airlineId     String
  origin        String
  destination   String
  cargoType     String   @default("GCR")
  minimumCharge Float
  normalRate    Float
  rate45Plus    Float
  rate100Plus   Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  airline Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  @@unique([airlineId, origin, destination, cargoType])
  @@index([airlineId, origin, destination])
}

model AwbSequence {
  id         String @id @default(cuid())
  airlineId  String @unique
  nextSerial Int    @default(1)

  airline Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id               String                    @id @default(cuid())
  trackingNumber   String                    @unique
  airlineId        String?
  airline          Airline?                  @relation(fields: [airlineId], references: [id])
  flightNumber     String?
  bookingDate      DateTime
  origin           String
  destination      String
  status           ShipmentStatus            @default(BOOKED)
  senderName       String
  senderPhone      String
  senderAddress    String
  receiverName     String
  receiverPhone    String
  receiverAddress  String
  packageCount     Int
  actualWeight     Float
  volumetricWeight Float
  chargeableWeight Float
  contents         String?
  freight          Float
  gst              Float
  total            Float
  paymentReference String?
  remarks          String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  receiverCity     String?
  receiverGSTIN    String?
  receiverPincode  String?
  receiverState    String?
  senderCity       String?
  senderGSTIN      String?
  senderPincode    String?
  senderState      String?
  deliveryChallans DeliveryChallanShipment[]
  manifestEntries  ManifestShipment[]
  packages         ShipmentPackage[]
  loadingTallies   LoadingTallyShipment[]

  clientId        String?
  agentId         String?
  createdByUserId String?

  client    Client? @relation(fields: [clientId], references: [id])
  agent     Agent?  @relation(fields: [agentId], references: [id])
  createdBy User?   @relation("ShipmentCreatedBy", fields: [createdByUserId], references: [id])

  @@index([clientId])
  @@index([agentId])
  @@index([createdByUserId])
}

model ShipmentPackage {
  id         String   @id @default(cuid())
  shipmentId String
  length     Float
  width      Float
  height     Float
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
}

model Manifest {
  id             String         @id @default(cuid())
  manifestNumber String         @unique
  manifestDate   DateTime
  origin         String
  destination    String
  flightNumber   String?
  vehicleNumber  String?
  remarks        String?
  status         ManifestStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  loadingTallyId String?
  loadingTally   LoadingTally? @relation(fields: [loadingTallyId], references: [id])

  deliveryChallans      DeliveryChallan[]
  shipments             ManifestShipment[]
  loadingTallyShipments LoadingTallyShipment[]
}

model ManifestShipment {
  id         String   @id @default(cuid())
  manifestId String
  shipmentId String
  createdAt  DateTime @default(now())
  manifest   Manifest @relation(fields: [manifestId], references: [id])
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([manifestId, shipmentId])
}

model DeliveryChallan {
  id              String                    @id @default(cuid())
  challanNumber   String                    @unique
  challanDate     DateTime
  manifestId      String?
  customerName    String
  customerAddress String
  customerPhone   String
  flightNumber    String?
  vehicleNumber   String?
  remarks         String?
  status          DeliveryChallanStatus     @default(OPEN)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  manifest        Manifest?                 @relation(fields: [manifestId], references: [id])
  shipments       DeliveryChallanShipment[]
}

model DeliveryChallanShipment {
  id         String          @id @default(cuid())
  challanId  String
  shipmentId String
  challan    DeliveryChallan @relation(fields: [challanId], references: [id])
  shipment   Shipment        @relation(fields: [shipmentId], references: [id])

  @@unique([challanId, shipmentId])
}

model DayEnd {
  id               String       @id @default(cuid())
  businessDate     DateTime
  branch           String
  bookingCount     Int
  manifestCount    Int
  outscanCount     Int
  deliveredCount   Int
  pendingDelivery  Int
  revenue          Float
  cashCollection   Float
  onlineCollection Float
  status           DayEndStatus @default(OPEN)
  closedBy         String?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
}

model Branch {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  address   String?
  phone     String?
  email     String?
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  users     User[]
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  fullName     String
  email        String?      @unique
  phone        String?
  role         UserRole     @default(BOOKING)
  status       MasterStatus @default(ACTIVE)

  branchId String?
  clientId String?
  agentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  branch   Branch?   @relation(fields: [branchId], references: [id])
  client   Client?   @relation(fields: [clientId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])

  employeeProfile    EmployeeProfile?
  createdShipments   Shipment[]          @relation("ShipmentCreatedBy")
  onboardingRequests OnboardingRequest[] @relation("OnboardingCreatedBy")

  @@index([clientId])
  @@index([agentId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanySettings {
  id          String   @id @default(cuid())
  companyName String
  tagline     String?
  phone       String?
  email       String?
  website     String?
  address     String?
  gstNumber   String?
  panNumber   String?
  linkedin    String?
  facebook    String?
  instagram   String?
  youtube     String?
  supportText String   @default("24×7")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  gstNumber     String?
  panNumber     String?
  status        MasterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Client {
  id                String       @id @default(cuid())
  code              String       @unique
  companyName       String
  gstNumber         String?
  contactPerson     String?
  designation       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  origin            String?
  destination       String?
  serviceType       String?
  shipmentFrequency String?
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users     User[]
  shipments Shipment[]
}

model Agent {
  id                String       @id @default(cuid())
  code              String       @unique
  companyName       String
  agentType         AgentType
  gstNumber         String?
  contactPerson     String?
  designation       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  airport           String?
  destination       String?
  serviceType       String?
  shipmentFrequency String?
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  users     User[]
  shipments Shipment[]
}

model EmployeeProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  employeeCode String?      @unique
  city         String?
  airport      String?
  destination  String?
  status       MasterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingRequest {
  id            String           @id @default(cuid())
  requestNumber String           @unique
  type          OnboardingType
  status        OnboardingStatus @default(PENDING)
  details       Json

  financeStatus ApprovalDecision @default(PENDING)
  mdStatus      ApprovalDecision @default(PENDING)

  financeToken String @unique
  mdToken      String @unique

  createdByUserId String
  createdBy       User   @relation("OnboardingCreatedBy", fields: [createdByUserId], references: [id])

  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

model LoadingTally {
  id                 String             @id @default(cuid())
  loadingTallyNumber String             @unique
  loadingDate        DateTime
  remarks            String?
  status             LoadingTallyStatus @default(OPEN)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  shipments LoadingTallyShipment[]
  manifests Manifest[]
}

model LoadingTallyShipment {
  id             String   @id @default(cuid())
  loadingTallyId String
  shipmentId     String
  manifestId     String?
  createdAt      DateTime @default(now())

  loadingTally LoadingTally @relation(fields: [loadingTallyId], references: [id])
  shipment     Shipment     @relation(fields: [shipmentId], references: [id])
  manifest     Manifest?    @relation(fields: [manifestId], references: [id])

  @@unique([loadingTallyId, shipmentId])
}

enum LoadingTallyStatus {
  OPEN
  COMPLETED
}

enum ShipmentStatus {
  BOOKED
  INSCAN
  MANIFESTED
  OUTSCAN
  DELIVERED
  CANCELLED
}

enum ManifestStatus {
  OPEN
  CLOSED
}

enum DeliveryChallanStatus {
  OPEN
  DELIVERED
  CANCELLED
}

enum DayEndStatus {
  OPEN
  CLOSED
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum AgentType {
  COURIER_COMPANY
  LOGISTICS_COMPANY
  AGGREGATOR
}

enum OnboardingType {
  CLIENT
  AGENT
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN

  CLIENT
  AGENT
  EMPLOYEE

  BOOKING
  WAREHOUSE
  DELIVERY
  ACCOUNTS
  READONLY
}
