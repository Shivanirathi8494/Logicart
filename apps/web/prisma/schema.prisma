generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LogicartsSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Airline {
  id              String           @id @default(cuid())
  name            String           @unique
  iataDesignator  String           @unique
  icaoCode        String           @unique
  iataPrefix      String?          @unique
  country         String           @default("India")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cargoTariffs    AirCargoTariff[]
  awbSequence     AwbSequence?
  flightSchedules FlightSchedule[]
  shipments       Shipment[]

  panNumber String?
  gstNumber String?
}

model FlightScheduleSync {
  id           String   @id @default(cuid())
  origin       String
  destination  String
  flightDate   DateTime
  provider     String   @default("AERODATABOX")
  resultCount  Int      @default(0)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([origin, destination, flightDate])
  @@index([origin, destination])
  @@index([lastSyncedAt])
}

model FlightSchedule {
  id                 String   @id @default(cuid())
  airlineId          String
  flightNumber       String
  origin             String
  destination        String
  scheduledDeparture DateTime
  scheduledArrival   DateTime
  aircraftType       String?
  departureTerminal  String?
  arrivalTerminal    String?
  source             String   @default("AERODATABOX")
  externalId         String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  airline            Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  @@unique([flightNumber, origin, destination, scheduledDeparture])
  @@index([origin, destination, scheduledDeparture])
  @@index([airlineId])
  @@index([flightNumber])
}

model AirCargoTariff {
  id            String   @id @default(cuid())
  airlineId     String
  origin        String
  destination   String
  cargoType     String   @default("GCR")
  minimumCharge Float
  normalRate    Float
  rate45Plus    Float
  rate100Plus   Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  airline       Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  @@unique([airlineId, origin, destination, cargoType])
  @@index([airlineId, origin, destination])
}

model AwbSequence {
  id         String   @id @default(cuid())
  airlineId  String   @unique
  nextSerial Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  airline    Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                 String         @id @default(cuid())
  trackingNumber     String         @unique
  bookingDate        DateTime
  origin             String
  destination        String
  status             ShipmentStatus @default(BOOKED)
  senderName         String
  senderPhone        String
  senderAddress      String
  receiverName       String
  receiverPhone      String
  receiverAddress    String
  packageCount       Int
  actualWeight       Float
  volumetricWeight   Float
  chargeableWeight   Float
  contents           String?
  freight            Float
  gst                Float
  total              Float
  paymentReference   String?
  remarks            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  receiverCity       String?
  receiverGSTIN      String?
  receiverPincode    String?
  receiverState      String?
  senderCity         String?
  senderGSTIN        String?
  senderPincode      String?
  senderState        String?
  airlineId          String?
  flightNumber       String?
  agentId            String?
  clientId           String?
  createdByUserId    String?
  aircraftType       String?
  arrivalTerminal    String?
  customerId         String?
  departureTerminal  String?
  scheduledArrival   DateTime?
  scheduledDeparture DateTime?

  // Optional Air Waybill fields.
  // Leave null unless the actual AWB/business value is known.
  invoiceNumber            String?
  invoiceValue             Float?
  shipperAccountNumber     String?
  consigneeAccountNumber   String?
  agentIataCode            String?
  rateClass                String?
  commodityItemNumber      String?
  declaredValueForCarriage Float?
  declaredValueForCustoms  Float?
  insuranceAmount          Float?
  specialCargoIndicator    String?
  deliveryChallans         DeliveryChallanShipment[]
  deliveryAttempts         DeliveryAttempt[]
  outForDeliveryRecords    OutForDeliveryRecord[]
  loadingTallies           LoadingTallyShipment[]
  manifestEntries          ManifestShipment[]
  trackingEvents           ShipmentTrackingEvent[]
  pricingSnapshot          ShipmentPricingSnapshot?
  walletTransactions       ClientWalletTransaction[]
  agent                    Agent?                    @relation(fields: [agentId], references: [id])
  airline                  Airline?                  @relation(fields: [airlineId], references: [id])
  client                   Client?                   @relation(fields: [clientId], references: [id])
  createdBy                User?                     @relation("ShipmentCreatedBy", fields: [createdByUserId], references: [id])
  customer                 Customer?                 @relation(fields: [customerId], references: [id])
  packages                 ShipmentPackage[]

  // IATA-style AWB supplementary fields
  currency                   String? @default("INR")
  accountingInformation      String?
  chargesCode                String?
  weightValuationPaymentType String?
  otherChargesPaymentType    String?

  shipperCountry  String?
  receiverCountry String?

  handlingCode        String?
  handlingDescription String?

  valuationCharge         Float?
  collectWeightCharge     Float?
  otherChargesDueAgent    Float?
  otherChargesDueCarrier  Float?
  otherChargesDescription String?

  totalPrepaid Float?
  totalCollect Float?

  currencyConversionRate Float?
  destinationCurrency    String?
  chargesAtDestination   Float?
  totalCollectCharges    Float?

  carrierUseAtDestination String?

  executedAt                  DateTime?
  executedPlace               String?
  shipperSignatureName        String?
  issuingCarrierSignatureName String?

  @@index([customerId])
  @@index([clientId])
  @@index([agentId])
  @@index([createdByUserId])
}

model ShipmentPackage {
  id         String @id @default(cuid())
  shipmentId String
  length     Float
  width      Float
  height     Float
  weight     Float  @default(0)

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  loadingTallyPackages   LoadingTallyPackage[]
  manifestUnloadPackages ManifestUnloadPackage[]
}

model Manifest {
  id                    String                  @id @default(cuid())
  manifestNumber        String                  @unique
  manifestDate          DateTime
  origin                String
  destination           String
  flightNumber          String?
  vehicleNumber         String?
  remarks               String?
  status                ManifestStatus          @default(OPEN)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  loadingTallyId        String?
  deliveryChallans      DeliveryChallan[]
  loadingTallyShipments LoadingTallyShipment[]
  loadingTally          LoadingTally?           @relation(fields: [loadingTallyId], references: [id])
  shipments             ManifestShipment[]
  unloadPackages        ManifestUnloadPackage[]
}

model ManifestUnloadPackage {
  id         String   @id @default(cuid())
  manifestId String
  packageId  String
  unloaded   Boolean  @default(true)
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manifest Manifest        @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  package  ShipmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([manifestId, packageId])
  @@index([packageId])
}

model ManifestShipment {
  id         String   @id @default(cuid())
  manifestId String
  shipmentId String
  createdAt  DateTime @default(now())
  manifest   Manifest @relation(fields: [manifestId], references: [id])
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([manifestId, shipmentId])
}

model DeliveryChallan {
  id            String   @id @default(cuid())
  challanNumber String   @unique
  challanDate   DateTime
  manifestId    String?

  deliveryType DeliveryType @default(DOOR_TO_DOOR)

  // Snapshot of the party receiving the shipment.
  // For DOOR_TO_DOOR these contain receiver details.
  // For AIRPORT_DELIVERY these contain airport vendor details.
  customerName    String
  customerAddress String
  customerPhone   String

  flightNumber  String?
  vehicleNumber String?
  remarks       String?

  status    DeliveryChallanStatus @default(OPEN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  manifest  Manifest?                 @relation(fields: [manifestId], references: [id])
  shipments DeliveryChallanShipment[]

  @@index([deliveryType])
}

model DeliveryChallanShipment {
  id         String          @id @default(cuid())
  challanId  String
  shipmentId String
  challan    DeliveryChallan @relation(fields: [challanId], references: [id])
  shipment   Shipment        @relation(fields: [shipmentId], references: [id])

  // One shipment/AWB can belong to only one Delivery Challan.
  // This also protects against two operators generating
  // separate challans for the same AWB concurrently.
  @@unique([shipmentId])
}

model OutForDeliveryRecord {
  id              String   @id @default(cuid())
  shipmentId      String
  vehicleNumber   String
  receiverName    String
  receiverPhone   String
  receiverAddress String
  remarks         String?
  dispatchedAt    DateTime @default(now())
  createdByUserId String?

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("OutForDeliveryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([vehicleNumber])
  @@index([dispatchedAt])
}

model DeliveryAttempt {
  id              String   @id @default(cuid())
  shipmentId      String
  createdByUserId String?
  outcome         String
  remarks         String
  receiverName    String?
  receiverPhone   String?
  receiverAddress String?
  attemptedAt     DateTime @default(now())

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("DeliveryAttemptCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([createdByUserId])
  @@index([attemptedAt])
}

model DayEnd {
  id               String       @id @default(cuid())
  businessDate     DateTime
  branch           String
  bookingCount     Int
  manifestCount    Int
  outscanCount     Int
  deliveredCount   Int
  pendingDelivery  Int
  revenue          Float
  cashCollection   Float
  onlineCollection Float
  status           DayEndStatus @default(OPEN)
  closedBy         String?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
}

model Branch {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  address   String?
  phone     String?
  email     String?
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  users     User[]
}

model User {
  id                              String                    @id @default(cuid())
  username                        String                    @unique
  passwordHash                    String
  fullName                        String
  email                           String?                   @unique
  phone                           String?
  role                            UserRole                  @default(BOOKING)
  status                          MasterStatus              @default(ACTIVE)
  branchId                        String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  agentId                         String?
  clientId                        String?
  employeeProfile                 EmployeeProfile?
  onboardingRequests              OnboardingRequest[]       @relation("OnboardingCreatedBy")
  sessions                        Session[]
  createdShipments                Shipment[]                @relation("ShipmentCreatedBy")
  deliveryAttempts                DeliveryAttempt[]         @relation("DeliveryAttemptCreatedBy")
  outForDeliveryCreated           OutForDeliveryRecord[]    @relation("OutForDeliveryCreatedBy")
  shipmentTrackingEvents          ShipmentTrackingEvent[]   @relation("ShipmentTrackingEventCreatedBy")
  clientWalletTransactionsCreated ClientWalletTransaction[] @relation("ClientWalletTransactionCreatedBy")
  agent                           Agent?                    @relation(fields: [agentId], references: [id])
  branch                          Branch?                   @relation(fields: [branchId], references: [id])
  client                          Client?                   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([agentId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanySettings {
  id          String   @id @default(cuid())
  companyName String
  tagline     String?
  phone       String?
  email       String?
  website     String?
  address     String?
  gstNumber   String?
  panNumber   String?
  linkedin    String?
  facebook    String?
  instagram   String?
  youtube     String?
  supportText String   @default("24×7")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  gstNumber     String?
  panNumber     String?
  status        MasterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  shipments     Shipment[]
}

model Client {
  id                String       @id @default(cuid())
  code              String       @unique
  companyName       String
  gstNumber         String?
  contactPerson     String?
  designation       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  origin            String?
  destination       String?
  serviceType       String?
  shipmentFrequency String?
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  shipments         Shipment[]
  users             User[]

  // Commercial configuration
  billingType        ClientBillingType         @default(PREPAID_WALLET)
  rateContracts      ClientRateContract[]
  wallet             ClientWallet?
  walletTransactions ClientWalletTransaction[]
  walletRecharges    ClientWalletRecharge[]
}

// =========================================================
// CLIENT COMMERCIAL / CONTRACT PRICING
// =========================================================

model ClientRateContract {
  id             String       @id @default(cuid())
  clientId       String
  version        Int
  name           String?
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  status         MasterStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client           Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  routes           ClientRateRoute[]
  pricingSnapshots ShipmentPricingSnapshot[]

  @@unique([clientId, version])
  @@index([clientId, effectiveFrom])
  @@index([clientId, status])
}

model ClientRateRoute {
  id             String @id @default(cuid())
  rateContractId String
  origin         String
  destination    String
  serviceType    String

  minimumFreight   Decimal @default(0) @db.Decimal(12, 2)
  awbCharge        Decimal @default(0) @db.Decimal(12, 2)
  handlingCharge   Decimal @default(0) @db.Decimal(12, 2)
  pickupCharge     Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharge   Decimal @default(0) @db.Decimal(12, 2)
  fuelSurchargePct Decimal @default(0) @db.Decimal(7, 3)
  gstPct           Decimal @default(18) @db.Decimal(7, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateContract ClientRateContract @relation(fields: [rateContractId], references: [id], onDelete: Cascade)
  slabs        ClientRateSlab[]

  @@index([rateContractId])
  @@index([origin, destination, serviceType])
}

model ClientRateSlab {
  id          String   @id @default(cuid())
  rateRouteId String
  minWeight   Float
  maxWeight   Float?
  ratePerKg   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rateRoute ClientRateRoute @relation(fields: [rateRouteId], references: [id], onDelete: Cascade)

  @@index([rateRouteId, minWeight])
}

model ClientWallet {
  id        String   @id @default(cuid())
  clientId  String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions ClientWalletTransaction[]
  recharges    ClientWalletRecharge[]
}

model ClientWalletTransaction {
  id              String                      @id @default(cuid())
  walletId        String
  clientId        String
  shipmentId      String?
  type            ClientWalletTransactionType
  amount          Decimal                     @db.Decimal(14, 2)
  balanceBefore   Decimal                     @db.Decimal(14, 2)
  balanceAfter    Decimal                     @db.Decimal(14, 2)
  reference       String?
  remarks         String?
  createdByUserId String?
  createdAt       DateTime                    @default(now())

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  clientWallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ClientWalletTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  recharge ClientWalletRecharge?

  @@index([walletId, createdAt])
  @@index([clientId, createdAt])
  @@index([shipmentId])
}

model ClientWalletRecharge {
  id String @id @default(cuid())

  clientId String
  walletId String

  amount Decimal @db.Decimal(14, 2)

  paymentMethod ClientWalletRechargeMethod
  status        ClientWalletRechargeStatus @default(PENDING)

  referenceNumber String? @unique

  provider          String?
  providerOrderId   String? @unique
  providerPaymentId String? @unique

  bankReference           String?
  bankReferenceNormalized String? @unique
  walletTransactionId     String? @unique
  remarks                 String?

  createdByUserId String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  client            Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  wallet            ClientWallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletTransaction ClientWalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([walletId, createdAt])
  @@index([status])
  @@index([paymentMethod])
}

model ShipmentPricingSnapshot {
  id              String  @id @default(cuid())
  shipmentId      String  @unique
  rateContractId  String?
  contractVersion Int?

  pricingSource ShipmentPricingSource

  serviceType      String?
  actualWeight     Float
  volumetricWeight Float
  chargeableWeight Float

  ratePerKg     Decimal @db.Decimal(12, 2)
  freightAmount Decimal @db.Decimal(14, 2)

  minimumFreight Decimal @default(0) @db.Decimal(14, 2)
  awbCharge      Decimal @default(0) @db.Decimal(14, 2)
  handlingCharge Decimal @default(0) @db.Decimal(14, 2)
  pickupCharge   Decimal @default(0) @db.Decimal(14, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(14, 2)
  fuelSurcharge  Decimal @default(0) @db.Decimal(14, 2)

  subtotal    Decimal @db.Decimal(14, 2)
  gstAmount   Decimal @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  shipment     Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  rateContract ClientRateContract? @relation(fields: [rateContractId], references: [id], onDelete: SetNull)

  @@index([rateContractId])
  @@index([pricingSource])
}

model Agent {
  id                String       @id @default(cuid())
  code              String       @unique
  companyName       String
  agentType         AgentType
  gstNumber         String?
  contactPerson     String?
  designation       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  airport           String?
  destination       String?
  serviceType       String?
  shipmentFrequency String?
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  shipments         Shipment[]
  users             User[]
}

model EmployeeProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  employeeCode String?      @unique
  city         String?
  airport      String?
  destination  String?
  status       MasterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingRequest {
  id              String           @id @default(cuid())
  requestNumber   String           @unique
  type            OnboardingType
  status          OnboardingStatus @default(PENDING)
  details         Json
  financeStatus   ApprovalDecision @default(PENDING)
  mdStatus        ApprovalDecision @default(PENDING)
  financeToken    String           @unique
  mdToken         String           @unique
  createdByUserId String
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       User             @relation("OnboardingCreatedBy", fields: [createdByUserId], references: [id])

  @@index([status])
  @@index([type])
}

model LoadingTally {
  id                 String                 @id @default(cuid())
  loadingTallyNumber String                 @unique
  loadingDate        DateTime
  remarks            String?
  status             LoadingTallyStatus     @default(OPEN)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  shipments          LoadingTallyShipment[]
  packages           LoadingTallyPackage[]
  manifests          Manifest[]
}

model LoadingTallyShipment {
  id             String       @id @default(cuid())
  loadingTallyId String
  shipmentId     String
  manifestId     String?
  createdAt      DateTime     @default(now())
  loadingTally   LoadingTally @relation(fields: [loadingTallyId], references: [id])
  manifest       Manifest?    @relation(fields: [manifestId], references: [id])
  shipment       Shipment     @relation(fields: [shipmentId], references: [id])

  @@unique([loadingTallyId, shipmentId])
}

model LoadingTallyPackage {
  id             String   @id @default(cuid())
  loadingTallyId String
  packageId      String
  loaded         Boolean  @default(true)
  remarks        String?
  createdAt      DateTime @default(now())

  loadingTally LoadingTally    @relation(fields: [loadingTallyId], references: [id], onDelete: Cascade)
  package      ShipmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([loadingTallyId, packageId])
  @@index([packageId])
}

model ShipmentTrackingEvent {
  id              String                    @id @default(cuid())
  shipmentId      String
  status          ShipmentStatus
  eventType       ShipmentTrackingEventType @default(STATUS_CHANGE)
  locationCode    String
  locationName    String?
  eventAt         DateTime                  @default(now())
  createdByUserId String?
  remarks         String?
  createdAt       DateTime                  @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdBy User? @relation("ShipmentTrackingEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId, eventAt])
  @@index([status])
  @@index([locationCode])
  @@index([createdByUserId])
}

enum ClientBillingType {
  PREPAID_WALLET
  CREDIT_ACCOUNT
  PAY_PER_BOOKING
}

enum ClientWalletRechargeMethod {
  BANK_TRANSFER
  ONLINE_PAYMENT
}

enum ClientWalletRechargeStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum ClientWalletTransactionType {
  CREDIT
  BOOKING_DEBIT
  BOOKING_REFUND
  ADMIN_ADJUSTMENT
}

enum ShipmentPricingSource {
  STANDARD_RATE
  CLIENT_RATE_CARD
}

enum LoadingTallyStatus {
  OPEN
  COMPLETED
}

enum ShipmentTrackingEventType {
  STATUS_CHANGE
  DELIVERY_ATTEMPT
}

enum ShipmentStatus {
  BOOKED
  INSCAN
  MANIFESTED
  RECEIVED
  OUTSCAN
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ManifestStatus {
  OPEN
  CLOSED
}

enum DeliveryType {
  AIRPORT_DELIVERY
  DOOR_TO_DOOR
}

enum DeliveryChallanStatus {
  OPEN
  DELIVERED
  CANCELLED
}

enum DayEndStatus {
  OPEN
  CLOSED
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum AgentType {
  COURIER_COMPANY
  LOGISTICS_COMPANY
  AGGREGATOR
}

enum OnboardingType {
  CLIENT
  AGENT
}

