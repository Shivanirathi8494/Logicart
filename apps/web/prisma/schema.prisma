generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LogicartsSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Airline {
  id              String           @id @default(cuid())
  name            String           @unique
  iataDesignator  String           @unique
  icaoCode        String           @unique
  iataPrefix      String?          @unique
  country         String           @default("India")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cargoTariffs    AirCargoTariff[]
  awbSequence     AwbSequence?
  flightSchedules FlightSchedule[]
  shipments       Shipment[]

  panNumber String?
  gstNumber String?
}

model FlightScheduleSync {
  id           String   @id @default(cuid())
  origin       String
  destination  String
  flightDate   DateTime
  provider     String   @default("AERODATABOX")
  resultCount  Int      @default(0)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([origin, destination, flightDate])
  @@index([origin, destination])
  @@index([lastSyncedAt])
}

model FlightSchedule {
  id                 String   @id @default(cuid())
  airlineId          String
  flightNumber       String
  origin             String
  destination        String
  scheduledDeparture DateTime
  scheduledArrival   DateTime
  aircraftType       String?
  departureTerminal  String?
  arrivalTerminal    String?
  source             String   @default("AERODATABOX")
  externalId         String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  airline            Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  @@unique([flightNumber, origin, destination, scheduledDeparture])
  @@index([origin, destination, scheduledDeparture])
  @@index([airlineId])
  @@index([flightNumber])
}

model AirCargoTariff {
  id            String   @id @default(cuid())
  airlineId     String
  origin        String
  destination   String
  cargoType     String   @default("GCR")
  minimumCharge Float
  normalRate    Float
  rate45Plus    Float
  rate100Plus   Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  airline       Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  @@unique([airlineId, origin, destination, cargoType])
  @@index([airlineId, origin, destination])
}

model AwbSequence {
  id         String   @id @default(cuid())
  airlineId  String   @unique
  nextSerial Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  airline    Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                 String         @id @default(cuid())
  trackingNumber     String         @unique
  bookingDate        DateTime
  origin             String
  destination        String
  status             ShipmentStatus @default(BOOKED)
  senderName         String
  senderPhone        String
  senderAddress      String
  receiverName       String
  receiverPhone      String
  receiverAddress    String
  packageCount       Int
  actualWeight       Float
  volumetricWeight   Float
  chargeableWeight   Float
  contents           String?
  freight            Float
  gst                Float
  total              Float
  paymentReference   String?
  remarks            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  receiverCity       String?
  receiverGSTIN      String?
  receiverPincode    String?
  receiverState      String?
  senderCity         String?
  senderGSTIN        String?
  senderPincode      String?
  senderState        String?
  airlineId          String?
  flightNumber       String?
  agentId            String?
  clientId           String?
  createdByUserId    String?
  aircraftType       String?
  arrivalTerminal    String?
  customerId         String?
  departureTerminal  String?
  scheduledArrival   DateTime?
  scheduledDeparture DateTime?

  // Optional Air Waybill fields.
  // Leave null unless the actual AWB/business value is known.
  invoiceNumber             String?
  invoiceValue              Float?
  shipperAccountNumber     String?
  consigneeAccountNumber   String?
  agentIataCode            String?
  rateClass                String?
  commodityItemNumber      String?
  declaredValueForCarriage Float?
  declaredValueForCustoms  Float?
  insuranceAmount          Float?
  specialCargoIndicator    String?
  deliveryChallans         DeliveryChallanShipment[]
  loadingTallies           LoadingTallyShipment[]
  manifestEntries          ManifestShipment[]
  agent                    Agent?                    @relation(fields: [agentId], references: [id])
  airline                  Airline?                  @relation(fields: [airlineId], references: [id])
  client                   Client?                   @relation(fields: [clientId], references: [id])
  createdBy                User?                     @relation("ShipmentCreatedBy", fields: [createdByUserId], references: [id])
  customer                 Customer?                 @relation(fields: [customerId], references: [id])
  packages                 ShipmentPackage[]

  // IATA-style AWB supplementary fields
  currency                   String? @default("INR")
  accountingInformation      String?
  chargesCode                String?
  weightValuationPaymentType String?
  otherChargesPaymentType    String?

  shipperCountry  String?
  receiverCountry String?

  handlingCode        String?
  handlingDescription String?

  valuationCharge         Float?
  collectWeightCharge     Float?
  otherChargesDueAgent    Float?
  otherChargesDueCarrier  Float?
  otherChargesDescription String?

  totalPrepaid Float?
  totalCollect Float?

  currencyConversionRate Float?
  destinationCurrency    String?
  chargesAtDestination   Float?
  totalCollectCharges    Float?

  carrierUseAtDestination String?

  executedAt                  DateTime?
  executedPlace               String?
  shipperSignatureName        String?
  issuingCarrierSignatureName String?

  @@index([customerId])
  @@index([clientId])
  @@index([agentId])
  @@index([createdByUserId])
}

model ShipmentPackage {
  id         String   @id @default(cuid())
  shipmentId String
  length     Float
  width      Float
  height     Float
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
}

model Manifest {
  id                    String                 @id @default(cuid())
  manifestNumber        String                 @unique
  manifestDate          DateTime
  origin                String
  destination           String
  flightNumber          String?
  vehicleNumber         String?
  remarks               String?
  status                ManifestStatus         @default(OPEN)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  loadingTallyId        String?
  deliveryChallans      DeliveryChallan[]
  loadingTallyShipments LoadingTallyShipment[]
  loadingTally          LoadingTally?          @relation(fields: [loadingTallyId], references: [id])
  shipments             ManifestShipment[]
}

model ManifestShipment {
  id         String   @id @default(cuid())
  manifestId String
  shipmentId String
  createdAt  DateTime @default(now())
  manifest   Manifest @relation(fields: [manifestId], references: [id])
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  @@unique([manifestId, shipmentId])
}

model DeliveryChallan {
  id              String                    @id @default(cuid())
  challanNumber   String                    @unique
  challanDate     DateTime
  manifestId      String?
  customerName    String
  customerAddress String
  customerPhone   String
  flightNumber    String?
  vehicleNumber   String?
  remarks         String?
  status          DeliveryChallanStatus     @default(OPEN)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  manifest        Manifest?                 @relation(fields: [manifestId], references: [id])
  shipments       DeliveryChallanShipment[]
}

model DeliveryChallanShipment {
  id         String          @id @default(cuid())
  challanId  String
  shipmentId String
  challan    DeliveryChallan @relation(fields: [challanId], references: [id])
  shipment   Shipment        @relation(fields: [shipmentId], references: [id])

  @@unique([challanId, shipmentId])
}

model DayEnd {
  id               String       @id @default(cuid())
  businessDate     DateTime
  branch           String
  bookingCount     Int
  manifestCount    Int
  outscanCount     Int
  deliveredCount   Int
  pendingDelivery  Int
  revenue          Float
  cashCollection   Float
  onlineCollection Float
  status           DayEndStatus @default(OPEN)
  closedBy         String?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
}

model Branch {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  address   String?
  phone     String?
  email     String?
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  users     User[]
}

model User {
  id                 String              @id @default(cuid())
  username           String              @unique
  passwordHash       String
  fullName           String
  email              String?             @unique
  phone              String?
  role               UserRole            @default(BOOKING)
  status             MasterStatus        @default(ACTIVE)
  branchId           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentId            String?
  clientId           String?
  employeeProfile    EmployeeProfile?
  onboardingRequests OnboardingRequest[] @relation("OnboardingCreatedBy")
  sessions           Session[]
  createdShipments   Shipment[]          @relation("ShipmentCreatedBy")
  agent              Agent?              @relation(fields: [agentId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  client             Client?             @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([agentId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanySettings {
  id          String   @id @default(cuid())
  companyName String
  tagline     String?
  phone       String?
  email       String?
  website     String?
  address     String?
  gstNumber   String?
  panNumber   String?
  linkedin    String?
  facebook    String?
  instagram   String?
  youtube     String?
  supportText String   @default("24×7")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  gstNumber     String?
  panNumber     String?
  status        MasterStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  shipments     Shipment[]
}

model Client {
  id                String       @id @default(cuid())
  code              String       @unique
  companyName       String
  gstNumber         String?
  contactPerson     String?
  designation       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  origin            String?
  destination       String?
  serviceType       String?
  shipmentFrequency String?
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  shipments         Shipment[]
  users             User[]
}

model Agent {
  id                String       @id @default(cuid())
  code              String       @unique
  companyName       String
  agentType         AgentType
  gstNumber         String?
  contactPerson     String?
  designation       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  airport           String?
  destination       String?
  serviceType       String?
  shipmentFrequency String?
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  shipments         Shipment[]
  users             User[]
}

model EmployeeProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  employeeCode String?      @unique
  city         String?
  airport      String?
  destination  String?
  status       MasterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingRequest {
  id              String           @id @default(cuid())
  requestNumber   String           @unique
  type            OnboardingType
  status          OnboardingStatus @default(PENDING)
  details         Json
  financeStatus   ApprovalDecision @default(PENDING)
  mdStatus        ApprovalDecision @default(PENDING)
  financeToken    String           @unique
  mdToken         String           @unique
  createdByUserId String
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       User             @relation("OnboardingCreatedBy", fields: [createdByUserId], references: [id])

  @@index([status])
  @@index([type])
}

model LoadingTally {
  id                 String                 @id @default(cuid())
  loadingTallyNumber String                 @unique
  loadingDate        DateTime
  remarks            String?
  status             LoadingTallyStatus     @default(OPEN)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  shipments          LoadingTallyShipment[]
  manifests          Manifest[]
}

model LoadingTallyShipment {
  id             String       @id @default(cuid())
  loadingTallyId String
  shipmentId     String
  manifestId     String?
  createdAt      DateTime     @default(now())
  loadingTally   LoadingTally @relation(fields: [loadingTallyId], references: [id])
  manifest       Manifest?    @relation(fields: [manifestId], references: [id])
  shipment       Shipment     @relation(fields: [shipmentId], references: [id])

  @@unique([loadingTallyId, shipmentId])
}

enum LoadingTallyStatus {
  OPEN
  COMPLETED
}

enum ShipmentStatus {
  BOOKED
  INSCAN
  MANIFESTED
  OUTSCAN
  DELIVERED
  CANCELLED
}

enum ManifestStatus {
  OPEN
  CLOSED
}

enum DeliveryChallanStatus {
  OPEN
  DELIVERED
  CANCELLED
}

enum DayEndStatus {
  OPEN
  CLOSED
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum AgentType {
  COURIER_COMPANY
  LOGISTICS_COMPANY
  AGGREGATOR
}

enum OnboardingType {
  CLIENT
  AGENT
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  BOOKING
  WAREHOUSE
  DELIVERY
  ACCOUNTS
  READONLY
  CLIENT
  AGENT
  EMPLOYEE
}
